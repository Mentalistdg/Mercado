# Configuración de la Aplicación
PORT=3000

# Credenciales de Autenticación
# Usuario para acceder al informe
AUTH_USERNAME=admin

# Hash de la contraseña (generar con bcrypt)
# Para generar un hash nuevo, ejecuta en Node.js:
# const bcrypt = require('bcryptjs');
# console.log(bcrypt.hashSync('tu_contraseña', 10));
#
# Por defecto la contraseña es: admin123
AUTH_PASSWORD_HASH=$2a$10$XYZ... # Reemplazar con tu hash

# Secreto para las sesiones (cambiar en producción)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiar-este-secreto-en-produccion

# Entorno (development o production)
NODE_ENV=production
